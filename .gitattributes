# Generated output. Keep it out of language statistics and out of diffs, so a
# re-render doesn't bury a one-line source change. The rendered site itself
# lives on gh-pages and never appears on this branch; _freeze is the cached
# chunk output, which is committed.
_freeze/** linguist-generated=true
_freeze/** -diff

*.csv text eol=lf
*.qmd text eol=lf
*.R    text eol=lf
*.scss text eol=lf
*.png binary
